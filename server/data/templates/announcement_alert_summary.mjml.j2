<mjml>
  <mj-head>
    <mj-breakpoint width="600px" />
    <mj-attributes>
      <mj-all color="#2C2C2C" font-family="Arial" padding="0" />
      <mj-class name="email-header" align="center" font-size="26px" line-height="30px" padding="30px 20px" />

      <mj-class name="alert-card" background-color="#ffffff" padding="20px" margin="10px" border-radius="10px" border="1px solid #dddddd" />
      <mj-class name="alert-subheading" align="center" font-size="18px" font-weight="bold" line-height="20px" padding="5px 0px 10px 0px" color="#bf9b30"/>

    </mj-attributes>
  </mj-head>

  <mj-body background-color="#f5f5f5">
    <!-- Email Header -->
    <mj-wrapper padding="20px 20px">
      <mj-section>
        <mj-column>
          <mj-text mj-class="email-header">
            Out of <b>{{ num_sensitive }}</b> sensitive announcements, our systems flagged <b>{{ num_alerts }}</b> potentially significant release(s).
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Spacer -->
      <mj-section>
        <mj-column>
          <mj-spacer height="20px" />
        </mj-column>
      </mj-section>

      <mj-section mj-class="alert-card">
        <mj-column width="100%">
          <mj-table cellpadding="12px" width="100%" font-size="11px">
            <tr>
              <th style="width:15%; text-align:left">
                <b>Ticker</b>
              </th>
              <th style="width:15%; text-align:left">
                <b>Cap</b>
              </th>
              <th style="width:20%; text-align:left">
                <b>Result</b>
              </th>
              <th style="width:25%; text-align:left">
                <b>Article</b>
              </th>
              <th style="width:25%; text-align:left">
                <b>Document</b>
              </th>
            </tr>
            {% for alert in alerts %}
              <tr>
                <td>
                  {{ alert.ticker }}
                </td>
                <td>
                  {{ alert.market_cap }}
                </td>
                <td>
                  {{ alert.assay }}
                </td>
                <td>
                  <mjml-raw>
                    <a href={{ alert.article_url }}>
                      {{ alert.article_title }}
                    </a>
                  </mjml-raw>
                </td>
                <td>
                  <mjml-raw>
                    <a href={{ alert.document_url }}>
                      {{ alert.document_title }}
                    </a>
                  </mjml-raw>
                </td>
              </tr>
            {% endfor %}
          </mj-table>
        </mj-column>
      </mj-section>

      <!-- Spacer -->
      <mj-section>
        <mj-column>
          <mj-spacer height="20px" />
        </mj-column>
      </mj-section>

      <!-- Footer -->
      <mj-section padding="20px 40px" text-align="center">
        <mj-column width="90%" vertical-align="middle">
          <mj-text font-size="11px" color="#888888">
            You are receiving this email because you subscribed to RockStocks Alerts.
          </mj-text>
        </mj-column>
        <mj-column width="10%" vertical-align="middle">
          <mj-image
            src="https://rtwimages.s3.ap-southeast-2.amazonaws.com/LOGO.svg"
            href="https://www.rockstocks.ai"
            alt="Logo"
            width="40px"
            height="40px"
            padding="0"
          />
        </mj-column>
      </mj-section>

    </mj-wrapper>
  </mj-body>
</mjml>
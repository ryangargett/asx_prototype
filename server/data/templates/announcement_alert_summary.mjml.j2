<mjml>
  <mj-head>
    <mj-breakpoint width="600px" />
    <mj-attributes>
      <mj-all color="#2C2C2C" font-family="Arial" padding="0" />
      <mj-class name="email-header" align="center" font-size="26px" line-height="30px" padding="30px 20px" />
      
      <mj-class name="alert-card" background-color="#ffffff" padding="0" margin="10px 0" border-radius="8px" box-shadow="0 2px 8px rgba(0,0,0,0.1)" />
      <mj-class name="alert-subheading" align="center" font-size="18px" font-weight="bold" line-height="20px" padding="15px 0" color="#bf9b30"/>
      
      <!-- New classes for tables -->
      <mj-class name="table-header" font-size="12px" font-weight="bold" padding="12px 15px" background-color="#f8f8f8" color="#2C2C2C" />
      <mj-class name="table-cell" font-size="13px" padding="12px 15px" line-height="18px" border-bottom="1px solid #eeeeee" />
      <mj-class name="table-row" background-color="#ffffff" />
      <mj-class name="table-row-alt" background-color="#fafafa" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#f5f5f5">
    <!-- Email Header -->
    <mj-wrapper padding="20px 20px">
      <mj-section>
        <mj-column>
          <mj-text mj-class="email-header">
            Out of <b>{{ num_sensitive }}</b> sensitive announcements, our systems flagged <b>{{ num_alerts }}</b> potentially significant release(s).
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Spacer -->
      <mj-section>
        <mj-column>
          <mj-spacer height="20px" />
        </mj-column>
      </mj-section>

      <!-- Alerts Table -->
      <mj-section mj-class="alert-card">
        <mj-column width="100%">
          <mj-table cellpadding="0" width="100%">
            <tr style="border-bottom: 2px solid #eeeeee;">
              <th mj-class="table-header" style="text-align:left; width:15%;">
                Ticker
              </th>
              <th mj-class="table-header" style="text-align:left; width:15%;">
                Cap
              </th>
              <th mj-class="table-header" style="text-align:left; width:20%;">
                Result
              </th>
              <th mj-class="table-header" style="text-align:left; width:25%;">
                Article
              </th>
              <th mj-class="table-header" style="text-align:left; width:25%;">
                Document
              </th>
            </tr>
            {% for alert in alerts %}
              <tr mj-class="{% if loop.index % 2 == 0 %}table-row-alt{% else %}table-row{% endif %}">
                <td mj-class="table-cell">
                  <span style="font-weight: bold; color: #bf9b30;">{{ alert.ticker }}</span>
                </td>
                <td mj-class="table-cell">
                  {{ alert.market_cap }}
                </td>
                <td mj-class="table-cell">
                  <span style="font-weight: bold;">{{ alert.assay }}</span>
                </td>
                <td mj-class="table-cell">
                  <a href="{{ alert.article_url }}" style="color: #0066cc; text-decoration: none;">
                    {{ alert.article_title|truncate(40) }}
                  </a>
                </td>
                <td mj-class="table-cell">
                  <a href="{{ alert.document_url }}" style="color: #0066cc; text-decoration: none;">
                    {{ alert.document_title|truncate(40) }}
                  </a>
                </td>
              </tr>
            {% endfor %}
          </mj-table>
        </mj-column>
      </mj-section>

      <!-- Spacer -->
      <mj-section>
        <mj-column>
          <mj-spacer height="20px" />
        </mj-column>
      </mj-section>

      <!-- Metals Table -->
      <mj-section mj-class="alert-card">
        <mj-column width="100%">
          <mj-table cellpadding="0" width="100%">
            <tr style="border-bottom: 2px solid #eeeeee;">
              <th mj-class="table-header" style="text-align:left; width:30%;">
                Metal
              </th>
              <th mj-class="table-header" style="text-align:left; width:25%;">
                Raw Price
              </th>
              <th mj-class="table-header" style="text-align:left; width:25%;">
                Standardized Price
              </th>
              <th mj-class="table-header" style="text-align:left; width:20%;">
                % Change
              </th>
            </tr>
            {% for metal in metals %}
              <tr mj-class="{% if loop.index % 2 == 0 %}table-row-alt{% else %}table-row{% endif %}">
                <td mj-class="table-cell">
                  <span style="font-weight: bold;">{{ metal.name }}</span>
                </td>
                <td mj-class="table-cell">
                  ${{ metal.price }} / {{ metal.unit}}
                </td>
                <td mj-class="table-cell">
                  ${{ metal.adjusted_price }} / g
                </td>
                <td mj-class="table-cell" style="{% if metal.pct_change < 0 %}color: #e74c3c;{% elif metal.pct_change > 0 %}color: #2ecc71;{% else %}color: #AAAAAA;{% endif %} font-weight: bold;">
                  {{ metal.pct_change }}%
                </td>
              </tr>
            {% endfor %}
          </mj-table>
        </mj-column>
      </mj-section>

      <!-- Footer -->
      <mj-section padding="30px 40px 20px" text-align="center">
        <mj-column width="90%" vertical-align="middle">
          <mj-text font-size="11px" color="#888888" line-height="16px">
            You are receiving this email because you subscribed to RockStocks Alerts.<br />
          </mj-text>
        </mj-column>
        <mj-column width="10%" vertical-align="middle">
          <mj-image
            src="https://rtwimages.s3.ap-southeast-2.amazonaws.com/LOGO.svg"
            href="https://www.rockstocks.ai"
            alt="Logo"
            width="40px"
            height="40px"
            padding="0"
          />
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>